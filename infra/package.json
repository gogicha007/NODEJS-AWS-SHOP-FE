{
  "name": "infra",
  "version": "0.1.0",
  "bin": {
    "infra": "bin/infra.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "bootstrap": "cdk bootstrap aws://149614785775/eu-north-1 --profile vlab_dev",
    "deploy": "npm --prefix .. run build && npm run build && cdk deploy InfraStack --require-approval never",
    "deploy:vlab": "npm run deploy -- --profile vlab_dev",
    "diff": "cdk diff InfraStack",
    "synth": "cdk synth InfraStack"
  },
  "devDependencies": {
    "@types/jest": "^30",
    "@types/node": "^24.10.1",
    "jest": "^30",
    "ts-jest": "^29",
    "aws-cdk": "2.1118.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.248.0",
    "constructs": "^10.5.0"
  }
}
